<odoo>

<record id="view_sale_process_info_wizard_form" model="ir.ui.view">
    <field name="name">sale.process.info.wizard.form</field>
    <field name="model">sale.process.info.wizard</field>
    <field name="arch" type="xml">
        <form string="Detalle de Proceso">
            <sheet>
                <field
                    name="message"
                    readonly="1"
                    nolabel="1"/>
            </sheet>

            <footer>
                <button string="Cerrar"
                        class="btn-secondary"
                        special="cancel"/>
            </footer>
        </form>
    </field>
</record>

</odoo>
